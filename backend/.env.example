# EarlySight Backend Environment Configuration Example
# Copy this file to .env and adjust credentials for your local PostgreSQL setup.
# IMPORTANT: Do not commit actual passwords or .env files to version control.

# Application Server Settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=false

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/earlysight

# OpenAI AI / LLM Configuration
# Optional: Set your OpenAI API key to enable operational signal analysis and embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenAI Embedding & Related Signal Detection Configuration (Milestone 6)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RELATED_SIGNAL_LIMIT=5
RELATED_SIGNAL_THRESHOLD=0.70
CANDIDATE_SIGNAL_LIMIT=50

# Risk Scoring Model & Prioritization Weights (Milestone 7)
RISK_WEIGHT_SEVERITY=25
RISK_WEIGHT_FREQUENCY=20
RISK_WEIGHT_RECURRENCE=20
RISK_WEIGHT_RELATED_SIGNALS=20
RISK_WEIGHT_TREND=15
RISK_THRESHOLD_LOW=24
RISK_THRESHOLD_MODERATE=49
RISK_THRESHOLD_HIGH=74
RISK_THRESHOLD_CRITICAL=75
# Priority Ranking Thresholds
RISK_PRIORITY_CRITICAL_MIN=80
RISK_PRIORITY_HIGH_MIN=60
RISK_PRIORITY_MEDIUM_MIN=30

# Evidence Strength Thresholds (Milestone 8)
EVIDENCE_STRENGTH_HIGH_MIN=7
EVIDENCE_STRENGTH_MODERATE_MIN=4
